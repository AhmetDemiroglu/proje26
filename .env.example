# Firebase Console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console > App Check > Web app (optional but recommended for production)
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
REQUIRE_APP_CHECK=false

# Set to true only while the local Firebase emulators are running
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# Server-only Firebase Admin credentials. Never prefix with NEXT_PUBLIC_
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Local only. Requires FIRESTORE_EMULATOR_HOST and FIREBASE_AUTH_EMULATOR_HOST
FIREBASE_ADMIN_USE_EMULATORS=false

# Comma-separated, verified Firebase Authentication email addresses
ADMIN_EMAILS=

# A random secret of at least 32 characters for daily analytics session hashes
ANALYTICS_HASH_SALT=

# Google AI Studio key. Never prefix this variable with NEXT_PUBLIC_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Required before enabling scholarship profile collection in production
DATA_CONTROLLER_NAME=
DATA_CONTROLLER_EMAIL=
